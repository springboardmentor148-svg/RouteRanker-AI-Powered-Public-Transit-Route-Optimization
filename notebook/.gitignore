@'
# Python cache files
__pycache__/
*.py[cod]

# Virtual environments
.venv/
.venv*/
venv/
env/

# Secrets and local configuration
.env
.env.*
!.env.example

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Large raw GTFS datasets
data/raw/
'@ | Set-Content -Encoding utf8 .gitignore